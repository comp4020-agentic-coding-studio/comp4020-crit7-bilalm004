---
import Base from "../layouts/Base.astro";
import { getUser } from "../lib/users";

const user = getUser(Astro.cookies);
---

<Base title="Inbox" current="inbox">
  <main id="main" class="narrow">
    <h1>Inbox</h1>
    {
      !user ? (
        <div class="stack">
          <p class="callout-info" role="status">Sign in to see your messages and join requests.</p>
          <a class="button" href="/login/?next=/inbox/">Sign in</a>
        </div>
      ) : (
        <p class="callout-info" role="status">
          No messages yet. Requests to join your bookings will appear here once sharing is built.
        </p>
      )
    }
  </main>
</Base>
