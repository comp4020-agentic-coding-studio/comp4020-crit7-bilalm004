---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { SAMPLE_INBOX } from "../lib/sample";
import { getUser } from "../lib/users";

const user = getUser(Astro.cookies);
---

<Base title="Inbox" current="inbox">
  <main id="main" class="narrow">
    <h1>Inbox</h1>
    {
      !user ? (
        <p class="callout-info" role="status">
          <a href="/login/?next=/inbox/">Sign in</a> to see your messages and join requests.
        </p>
      ) : SAMPLE_INBOX.length === 0 ? (
        <p class="callout-info" role="status">No messages yet.</p>
      ) : (
        <>
          <p class="lede">Requests to join your bookings, and replies to yours.</p>
          <ul class="messages">
            {SAMPLE_INBOX.map((m) => (
              <li class="card message" data-unread={m.unread ? "true" : undefined}>
                <p class="message-title">
                  <strong>{m.title}</strong>
                  {m.unread && <span class="badge badge-shared">New</span>}
                </p>
                <p class="muted">{m.body}</p>
                {m.id === 1 && (
                  <p class="row">
                    <button type="button" disabled>
                      Accept
                    </button>
                    <button type="button" class="button-quiet" disabled>
                      Decline
                    </button>
                  </p>
                )}
              </li>
            ))}
          </ul>
          <p class="callout-info">
            <Icon name="info" size={16} /> Prototype: these are sample messages.
          </p>
        </>
      )
    }
  </main>
</Base>
