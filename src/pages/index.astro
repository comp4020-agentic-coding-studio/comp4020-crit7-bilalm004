---
import Icon from "../components/Icon.astro";
import ViewToggle from "../components/ViewToggle.astro";
import Base from "../layouts/Base.astro";
import {
  KIND_LABEL,
  KINDS,
  LIBRARIES,
  SPACES,
  getSpace,
  libraryName,
  type Space,
} from "../lib/rooms";
import { ADVANCE_DAYS, POOLS, poolOf } from "../lib/rules";
import { loadOccupancy, stateOf, usageToday, type State } from "../lib/availability";
import { bookingsOf } from "../lib/db";
import { bookableDates, canberraNow, dateLabel, hourLabel, slotLabel } from "../lib/time";
import { getUser } from "../lib/users";

const user = getUser(Astro.cookies);
const q = Astro.url.searchParams;
const now = canberraNow();
const dates = bookableDates(now.date, ADVANCE_DAYS);
const occ = loadOccupancy(dates[0], dates[dates.length - 1]);
const notice = { error: q.get("error"), booked: q.has("booked"), cancelled: q.has("cancelled") };

const pick = (value: string | null, allowed: readonly string[], fallback: string) =>
  allowed.includes(value ?? "") ? (value as string) : fallback;
const int = (value: string | null, min: number, max: number, fallback: number) => {
  const n = Number.parseInt(value ?? "", 10);
  return Number.isInteger(n) && n >= min && n <= max ? n : fallback;
};

const view = pick(q.get("view"), ["list", "grid"], "list") as "list" | "grid";
// The timetable shows one library at a time, so "all" falls back to Chifley there.
const libraryChoice = pick(q.get("library"), ["all", ...LIBRARIES.map((l) => l.id)], "all");
const library = view === "grid" && libraryChoice === "all" ? "chifley" : libraryChoice;
// A 60-row grid is unwieldy, so the Timetable starts on study rooms unless a type is chosen.
const kind = pick(q.get("kind"), ["any", ...KINDS], view === "grid" ? "study_room" : "any");
const date = pick(q.get("date"), dates, now.date);
const hour = int(q.get("time"), 0, 23, date === now.date ? Math.min(now.hour + 1, 23) : 9);
const people = int(q.get("people"), 1, 8, 1);
const sort = pick(q.get("sort"), ["best", "seats", "name"], "best");
const selectedId = q.get("space");

type Free = Extract<State, { kind: "free" }>;
type Shared = Extract<State, { kind: "shared" }>;
type Result = { space: Space; state: Free | Shared };

const results: Result[] = [];
for (const space of SPACES) {
  if (library !== "all" && space.library !== library) continue;
  if (kind !== "any" && space.kind !== kind) continue;
  const state = stateOf(space, date, hour, now, occ, user?.id);
  if (state.kind === "free" && space.capacity >= people) results.push({ space, state });
  if (state.kind === "shared" && state.spare >= people) results.push({ space, state });
}
const seats = (r: Result) => (r.state.kind === "shared" ? r.state.spare : r.space.capacity);
if (sort === "best") {
  results.sort((a, b) => seats(a) - people - (seats(b) - people) || a.space.order - b.space.order);
} else if (sort === "seats") {
  results.sort((a, b) => seats(b) - seats(a) || a.space.order - b.space.order);
}
const SHOWN = 40;
const shown = results.slice(0, SHOWN);

// Timetable window: 12 hours over one continuous run of bookable hours, so
// Later carries on past midnight. `from` is hours since today 00:00 (Canberra).
const WINDOW = 12;
const STEP = 6;
const maxFrom = dates.length * 24 - WINDOW;
const from = int(q.get("from"), 0, maxFrom, Math.min(dates.indexOf(date) * 24 + hour, maxFrom));
const cols = Array.from({ length: WINDOW }, (_, i) => {
  const abs = from + i;
  return { date: dates[Math.floor(abs / 24)], hour: abs % 24 };
});
const rangeLabel =
  cols[0].date === cols[WINDOW - 1].date
    ? dateLabel(cols[0].date)
    : `${dateLabel(cols[0].date)} – ${dateLabel(cols[WINDOW - 1].date)}`;
const sliderText = `${dateLabel(cols[0].date)}, ${hourLabel(cols[0].hour)}`;

const gridSpaces = SPACES.filter(
  (sp) => (library === "all" || sp.library === library) && (kind === "any" || sp.kind === kind),
);

// The strip: how many spaces fit your filters in each hour of the chosen day.
// Today starts at the current hour: past hours can't be booked, so they're left out.
const strip = Array.from({ length: 24 }, (_, h) => h)
  .filter((h) => date !== now.date || h >= now.hour)
  .map((h) => {
    let free = 0;
    let shared = 0;
    for (const sp of gridSpaces) {
      const st = stateOf(sp, date, h, now, occ, user?.id);
      if (st.kind === "free" && sp.capacity >= people) free++;
      if (st.kind === "shared" && st.spare >= people) shared++;
    }
    return { h, total: free + shared, shared };
  });

const href = (extra: Record<string, string | null> = {}) => {
  const p = new URLSearchParams({
    library,
    kind,
    date,
    time: hourLabel(hour),
    people: String(people),
    sort,
    view,
  });
  if (view === "grid") p.set("from", String(from));
  for (const [k, v] of Object.entries(extra)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  return `/?${p}`;
};

const dayParts = (d: string) => {
  const dt = new Date(`${d}T12:00:00Z`);
  const f = (o: Intl.DateTimeFormatOptions) => dt.toLocaleDateString("en-AU", { ...o, timeZone: "UTC" });
  return { weekday: f({ weekday: "short" }), rest: f({ day: "numeric", month: "short" }) };
};
const selected = selectedId ? getSpace(selectedId) : undefined;
const slotHours = Array.from({ length: Math.min(8, 24 - hour) }, (_, i) => hour + i);
const usage = user ? usageToday(bookingsOf(user.id), now) : null;
const timePassed = date === now.date && hour < now.hour;
const libraryText = library === "all" ? "All libraries" : libraryName(library as never);
const detailsHref = (spaceId: string, d: string, h: number) =>
  href({ space: spaceId, date: d, time: hourLabel(h) });
const kindText = kind === "any" ? "Any type" : KIND_LABEL[kind as keyof typeof KIND_LABEL];
const whenText = `${date === now.date ? "Today" : `${dayParts(date).weekday} ${dayParts(date).rest}`}, ${hourLabel(hour)}`;
const peopleText = `${people} ${people === 1 ? "person" : "people"}`;
---

<Base title="Find a study space" current="search">
  <main id="main">
    <div class="page-head">
      <h1>Find a study space</h1>
      <ViewToggle current={view} listHref={href({ view: "list", space: null })} gridHref={href({ view: "grid", space: null, kind: kind === "any" ? null : kind })} />
    </div>
    {notice.error && <p class="error" role="alert"><Icon name="x" size={16} /> {notice.error}</p>}
    {notice.booked && <p class="callout-info" role="status"><Icon name="check" size={16} /> Booked. See it under My bookings.</p>}

    <form class="panel filters" id="filters" method="get" action="/" aria-label="Search filters">
      <input type="hidden" name="view" value={view} />
      {view === "grid" && <input type="hidden" name="sort" value={sort} />}
      <div class="pills">
        <div class="pill" data-pop="library">
          <details class="pop">
            <summary>{libraryText}</summary>
            <fieldset class="pop-body">
              <legend>Library</legend>
              <div class="chips">
                {
                  [...(view === "grid" ? [] : [{ id: "all", name: "All libraries" }]), ...LIBRARIES].map((l) => (
                    <label class="chip">
                      <input type="radio" name="library" value={l.id} checked={library === l.id} />
                      <span>{l.name}</span>
                    </label>
                  ))
                }
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {library !== "all" && <a class="pill-x" href={href({ library: "all" })} aria-label={`Clear library: ${libraryText}`}><Icon name="x" size={14} /></a>}
        </div>

        <div class="pill" data-pop="kind">
          <details class="pop">
            <summary>{kindText}</summary>
            <fieldset class="pop-body">
              <legend>Space type</legend>
              <div class="chips">
                <label class="chip">
                  <input type="radio" name="kind" value="any" checked={kind === "any"} />
                  <span>Any type</span>
                </label>
                {
                  KINDS.map((k) => (
                    <label class="chip">
                      <input type="radio" name="kind" value={k} checked={kind === k} />
                      <span>{KIND_LABEL[k]}</span>
                    </label>
                  ))
                }
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {kind !== "any" && <a class="pill-x" href={href({ kind: "any" })} aria-label={`Clear type: ${kindText}`}><Icon name="x" size={14} /></a>}
        </div>

        <div class="pill" data-pop="when" data-keep>
          <details class="pop">
            <summary>{whenText}</summary>
            <fieldset class="pop-body pop-wide">
              <legend>Date</legend>
              <div class="chips days">
                {
                  dates.map((d, i) => (
                    <label class="chip chip-day">
                      <input type="radio" name="date" value={d} checked={date === d} />
                      <span>
                        <span class="chip-top">{i === 0 ? "Today" : dayParts(d).weekday}</span>
                        <span class="chip-sub">{dayParts(d).rest}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
              <label class="field">
                Start time
                <select name="time">
                  {
                    Array.from({ length: 24 }, (_, h) => (
                      <option value={hourLabel(h)} selected={hour === h}>
                        {hourLabel(h)}
                      </option>
                    ))
                  }
                </select>
              </label>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
        </div>

        <div class="pill" data-pop="people" data-keep>
          <details class="pop">
            <summary>{peopleText}</summary>
            <fieldset class="pop-body">
              <legend>People</legend>
              <div class="stepper">
                <button type="button" class="stepper-btn" data-step="-1" aria-label="Fewer people" hidden>−</button>
                <input id="people" type="number" name="people" min="1" max="8" value={people} inputmode="numeric" aria-label="Number of people" />
                <button type="button" class="stepper-btn" data-step="1" aria-label="More people" hidden>+</button>
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {people > 1 && <a class="pill-x" href={href({ people: "1" })} aria-label={`Clear people: ${peopleText}`}><Icon name="x" size={14} /></a>}
        </div>

        <button type="submit" id="filters-go">Search</button>
      </div>
    </form>

    {
      view === "list" && (
        <section class="strip" aria-labelledby="strip-title">
          <div class="strip-head">
            <h2 id="strip-title">Spaces free by hour · {date === now.date ? "today" : dateLabel(date)}</h2>
            <a href={href({ view: "grid", kind: kind === "any" ? null : kind })}>Open timetable →</a>
          </div>
          <div class="strip-scroll">
            <ol class="strip-cells">
              {strip.map((c) => (
                <li>
                  <a
                    class={`strip-cell${c.shared > 0 ? " has-shared" : ""}${c.total === 0 ? " is-zero" : ""}`}
                    href={href({ time: hourLabel(c.h), space: null })}
                    aria-current={c.h === hour ? "true" : undefined}
                    aria-label={`${hourLabel(c.h)}, ${c.total} available${c.shared > 0 ? `, ${c.shared} with shared seats` : ""}`}
                  >
                    <span class="strip-h">{String(c.h).padStart(2, "0")}</span>
                    <span class="strip-n">{c.total}</span>
                    {c.shared > 0 ? <Icon name="users" size={12} /> : <span class="strip-gap" />}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <div class={`search-layout${view === "grid" ? " grid-layout" : ""}`}>
      {
        view === "list" ? (
          <section aria-labelledby="results-heading">
        <div class="results-head">
          <h2 id="results-heading">{`${results.length} ${results.length === 1 ? "option" : "options"}`}</h2>
          <label class="sort">
            Sort
            <select name="sort" form="filters">
              <option value="best" selected={sort === "best"}>Best fit</option>
              <option value="seats" selected={sort === "seats"}>Most seats</option>
              <option value="name" selected={sort === "name"}>Name</option>
            </select>
          </label>
        </div>
        {
          results.length === 0 && (
            <p class="callout-info" role="status">
              {timePassed
                ? "That time has already passed. Pick a later hour."
                : "Nothing fits. Try another time, fewer people, or a different library."}
            </p>
          )
        }

        <ul class="results">
          {
            shown.map(({ space, state }) => (
              <li>
                <a
                  class="card result"
                  href={href({ space: space.id })}
                  aria-current={selected?.id === space.id ? "true" : undefined}
                >
                  <span class="result-top">
                    <strong>{space.name}</strong>
                    {state.kind === "free" ? (
                      <span class="badge badge-free">
                        <Icon name="check" size={16} /> Free · {space.capacity}{" "}
                        {space.capacity === 1 ? "seat" : "seats"}
                      </span>
                    ) : (
                      <span class="badge badge-shared">
                        <Icon name="users" size={16} /> {state.spare} of {space.capacity} seats open
                      </span>
                    )}
                  </span>
                  <span class="meta">
                    {libraryName(space.library)} · {KIND_LABEL[space.kind]} · {slotLabel(hour)}
                    {state.kind === "shared" && <> · Booked by {state.booker ?? "A student"}</>}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          results.length > SHOWN && (
            <p class="muted">
              Showing the first {SHOWN} of {results.length}. Narrow the filters to see the rest.
            </p>
          )
        }
          </section>
        ) : (
          <section aria-labelledby="results-heading">
            <div class="timetable-head">
              <h2 id="results-heading">{libraryName(library as never)} · {rangeLabel}</h2>
              <div class="row">
                {from > 0 ? (
                  <a class="button button-quiet" href={href({ from: String(Math.max(0, from - STEP)) })}>← Earlier</a>
                ) : (
                  <span class="button button-quiet is-off" aria-hidden="true">← Earlier</span>
                )}
                {from < maxFrom ? (
                  <a class="button button-quiet" href={href({ from: String(Math.min(maxFrom, from + STEP)) })}>Later →</a>
                ) : (
                  <span class="button button-quiet is-off" aria-hidden="true">Later →</span>
                )}
              </div>
            </div>

            <form class="slider panel" method="get" action="/" aria-label="Move through time" data-today={`${now.date}T12:00:00Z`}>
              <input type="hidden" name="library" value={library} />
              <input type="hidden" name="kind" value={kind} />
              <input type="hidden" name="date" value={date} />
              <input type="hidden" name="time" value={hourLabel(hour)} />
              <input type="hidden" name="people" value={people} />
              <input type="hidden" name="sort" value={sort} />
              <input type="hidden" name="view" value="grid" />
              {selectedId && <input type="hidden" name="space" value={selectedId} />}
              <label for="from">Jump to</label>
              <input id="from" name="from" type="range" min="0" max={maxFrom} step="1" value={from} />
              <output for="from" id="from-out">{sliderText}</output>
              <button type="submit" class="button button-quiet" id="from-go">Go</button>
            </form>

            {gridSpaces.length === 0 ? (
              <p class="callout-info" role="status">
                This library has no spaces of that type. Try another type.
              </p>
            ) : (
              <div class="scroll" role="region" aria-label="Timetable, scrolls sideways" tabindex="0">
                <table class="grid">
                  <thead>
                    <tr>
                      <th scope="col"><span class="sr-only">Space</span></th>
                      {cols.map((c, i) => (
                        <th scope="col">
                          {(i === 0 || c.hour === 0) && <span class="day">{dateLabel(c.date)}</span>}
                          {hourLabel(c.hour)}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {gridSpaces.map((space) => (
                      <tr>
                        <th scope="row">
                          {space.name}
                          <span class="cap">{space.capacity} {space.capacity === 1 ? "seat" : "seats"}</span>
                        </th>
                        {cols.map(({ date: d, hour: h }) => {
                          const st = stateOf(space, d, h, now, occ, user?.id);
                          const label = `${space.name}, ${hourLabel(h)}`;
                          const here = selected?.id === space.id && d === date && h === hour;
                          if (st.kind === "past")
                            return (
                              <td class="cell cell-past">
                                <span><span class="sr-only">{label}, passed</span></span>
                              </td>
                            );
                          if (st.kind === "booked")
                            return (
                              <td class="cell cell-booked">
                                <span>
                                  <Icon name="lock" size={16} />
                                  <span class="sr-only">{label}, booked</span>
                                </span>
                              </td>
                            );
                          const fits = (st.kind === "shared" ? st.spare : space.capacity) >= people;
                          const note = fits ? "" : `, too small for ${people} people`;
                          return st.kind === "shared" ? (
                            <td class={`cell cell-shared${fits ? "" : " cell-dim"}`}>
                              <a href={detailsHref(space.id, d, h)} aria-current={here ? "true" : undefined} aria-label={`${label}, ${st.spare} seats open${note}`}>
                                <Icon name="users" size={16} /> {st.spare}
                              </a>
                            </td>
                          ) : (
                            <td class={`cell cell-free${fits ? "" : " cell-dim"}`}>
                              <a href={detailsHref(space.id, d, h)} aria-current={here ? "true" : undefined} aria-label={`${label}, free${note}`}>
                                <Icon name="check" size={16} />
                              </a>
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            <p class="legend" aria-label="Legend">
              <span class="badge badge-free"><Icon name="check" size={16} /> Free</span>
              <span class="badge badge-shared"><Icon name="users" size={16} /> Seats open (number)</span>
              <span class="badge badge-booked"><Icon name="lock" size={16} /> Booked</span>
            </p>
            <p class="callout-info">
              <Icon name="info" size={16} /> The number after the icon is how many seats are open on a shared booking.
            </p>
          </section>
        )
      }

      {
        selected ? (
          <section class="sheet is-open" id="details" aria-labelledby="details-heading">
            <div class="sheet-head">
              <div>
                <h2 id="details-heading">{selected.name}</h2>
                <p class="muted">
                  {libraryName(selected.library)} · {KIND_LABEL[selected.kind]} · capacity{" "}
                  {selected.capacity}
                </p>
              </div>
              <a class="button button-quiet" href={href({ space: null })}>
                Close
              </a>
            </div>

            <p class="muted">{dateLabel(date)}. Each booking is one hour.</p>
            <ul class="slots">
              {slotHours.map((h) => {
                const state = stateOf(selected, date, h, now, occ, user?.id);
                return (
                  <li aria-current={h === hour ? "true" : undefined}>
                    <span class="slot-time">{slotLabel(h)}</span>
                    {state.kind === "free" && (
                      <>
                        <span class="badge badge-free">
                          <Icon name="check" size={16} /> Free
                        </span>
                        {user ? (
                          <form method="post" action="/api/book/">
                            <input type="hidden" name="space" value={selected.id} />
                            <input type="hidden" name="date" value={date} />
                            <input type="hidden" name="hour" value={h} />
                            <input type="hidden" name="next" value={href({ space: selected.id })} />
                            <button type="submit">Book</button>
                          </form>
                        ) : (
                          <a class="button" href="/login/">
                            Sign in to book
                          </a>
                        )}
                      </>
                    )}
                    {state.kind === "shared" && (
                      <>
                        <span class="badge badge-shared">
                          <Icon name="users" size={16} /> {state.spare} seat
                          {state.spare === 1 ? "" : "s"} open
                        </span>
                        {user ? (
                          <button type="button" disabled>
                            Join
                          </button>
                        ) : (
                          <a class="button" href="/login/">
                            Sign in to join
                          </a>
                        )}
                      </>
                    )}
                    {state.kind === "booked" && (
                      <span class="badge badge-booked">
                        <Icon name="lock" size={16} /> {state.mine ? "Your booking" : "Booked"}
                      </span>
                    )}
                    {state.kind === "past" && <span class="muted">Passed</span>}
                  </li>
                );
              })}
            </ul>

            {(() => {
              const state = stateOf(selected, date, hour, now, occ, user?.id);
              return (
                state.kind === "shared" && (
                  <div class="stack">
                    <p class="callout" role="note">
                      <strong>Seats on a shared booking aren’t guaranteed.</strong> The booker may
                      not turn up, or may use more space than they said.
                    </p>
                    <p class="muted">
                      Booked by <strong>{state.booker ?? "A student"}</strong>
                      {state.booker ? "" : " (name hidden by the booker)"}.
                    </p>
                    {state.requests ? (
                      <button type="button" disabled>
                        Ask the booker
                      </button>
                    ) : (
                      <p class="muted">The booker isn’t accepting requests for this booking.</p>
                    )}
                  </div>
                )
              );
            })()}

            {
              user && usage && (
                <p class="muted">
                  Today you’ve used {usage[poolOf(selected.kind)]} of{" "}
                  {POOLS[poolOf(selected.kind)].limit} {POOLS[poolOf(selected.kind)].label.toLowerCase()} bookings.
                </p>
              )
            }
          </section>
        ) : (
          view === "list" && (
            <p class="sheet-empty muted">Select an option to see its details and other times.</p>
          )
        )
      }
    </div>
  </main>
</Base>

<script>
  // Enhancement only. Without JavaScript the pills open natively and the
  // Search button submits the form; the − / + and Done buttons stay hidden.
  const form = document.querySelector<HTMLFormElement>("#filters");
  if (form) {
    const store = {
      get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
      set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch { /* ignore */ } },
      del: (k: string) => { try { sessionStorage.removeItem(k); } catch { /* ignore */ } },
    };
    const pills = [...form.querySelectorAll<HTMLElement>(".pill")];
    const details = pills.map((p) => p.querySelector<HTMLDetailsElement>("details")!);
    const sheet = matchMedia("(max-width: 47.99rem)");

    form.querySelector<HTMLElement>("#filters-go")!.hidden = true;
    form.querySelectorAll<HTMLElement>(".stepper-btn, .pop-done").forEach((b) => (b.hidden = false));

    const sync = () => {
      const open = details.find((d) => d.open);
      document.documentElement.toggleAttribute("data-sheet", !!open);
    };
    // Only one open at a time; Escape, Done and clicking outside close it.
    details.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) details.forEach((o) => o !== d && (o.open = false));
        sync();
      });
      d.querySelector(".pop-done")?.addEventListener("click", () => {
        d.open = false;
        d.querySelector("summary")?.focus();
      });
    });
    const closeAll = () => details.forEach((d) => (d.open = false));
    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest(".pill")) closeAll();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const d = details.find((x) => x.open);
      if (d) { d.open = false; d.querySelector("summary")?.focus(); }
    });

    // Date then time (and people) take a few taps, so those stay open after applying.
    // The flag is set only when a change is applied, and read once here.
    const keep = store.get("openPop");
    store.del("openPop");
    const back = pills.find((p) => p.dataset.pop === keep && "keep" in p.dataset);
    if (back) back.querySelector("details")!.open = true;
    void sheet;

    const input = form.querySelector<HTMLInputElement>("#people")!;
    form.querySelectorAll<HTMLElement>(".stepper-btn").forEach((b) =>
      b.addEventListener("click", () => {
        const next = Number(input.value) + Number(b.dataset.step);
        input.value = String(Math.min(8, Math.max(1, next)));
        form.dispatchEvent(new Event("change", { bubbles: true }));
      }),
    );

    // Apply on every change, keeping the scroll position across the reload.
    const submit = () => {
      const open = details.find((d) => d.open);
      if (open) store.set("openPop", open.parentElement!.dataset.pop!);
      store.set("searchScroll", String(scrollY));
      form.requestSubmit();
    };
    form.addEventListener("change", submit);
    document.querySelector<HTMLSelectElement>("select[name=sort]")?.addEventListener("change", submit);

    const y = store.get("searchScroll");
    if (y) {
      store.del("searchScroll");
      scrollTo(0, Number(y));
    }
  }
</script>

<script>
  // Enhancement only: bring the chosen hour into view in the availability strip,
  // and let the timetable slider apply when released (its Go button is the
  // no-JavaScript fallback).
  const strip = document.querySelector<HTMLElement>(".strip-scroll");
  const now = strip?.querySelector<HTMLElement>("[aria-current=true]");
  if (strip && now) {
    strip.scrollLeft = now.offsetLeft - strip.clientWidth / 2 + now.offsetWidth / 2;
  }

  const slider = document.querySelector<HTMLFormElement>(".slider");
  const range = slider?.querySelector<HTMLInputElement>("#from");
  const out = slider?.querySelector<HTMLOutputElement>("#from-out");
  const go = slider?.querySelector<HTMLElement>("#from-go");
  if (slider && range && out && go) {
    go.hidden = true;
    const today = new Date(slider.dataset.today ?? "");
    const label = (n: number) => {
      const d = new Date(today);
      d.setUTCDate(d.getUTCDate() + Math.floor(n / 24));
      const day = d.toLocaleDateString("en-AU", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
      return `${day}, ${String(n % 24).padStart(2, "0")}:00`;
    };
    range.addEventListener("input", () => (out.textContent = label(Number(range.value))));
    range.addEventListener("change", () => slider.requestSubmit());
  }
</script>

<script>
  // Live slot updates: when anyone books or cancels, reload to show it, unless
  // a filter popover is open (a reload would close it under the person's finger).
  // The stream says only that a slot changed, never who booked it.
  if ("EventSource" in window) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    new EventSource("/api/events").addEventListener("slot", () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (!document.querySelector("#filters details[open]")) location.reload();
      }, 800);
    });
  }
</script>
