---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import {
  KIND_LABEL,
  KINDS,
  LIBRARIES,
  SPACES,
  getSpace,
  libraryName,
  type Space,
} from "../lib/rooms";
import { ADVANCE_DAYS, POOLS, poolOf } from "../lib/rules";
import { sampleBookings, sampleState, usageToday, type State } from "../lib/sample";
import { bookableDates, canberraNow, dateLabel, hourLabel, slotLabel } from "../lib/time";
import { getUser } from "../lib/users";

const user = getUser(Astro.cookies);
const q = Astro.url.searchParams;
const now = canberraNow();
const dates = bookableDates(now.date, ADVANCE_DAYS);

const pick = (value: string | null, allowed: readonly string[], fallback: string) =>
  allowed.includes(value ?? "") ? (value as string) : fallback;
const int = (value: string | null, min: number, max: number, fallback: number) => {
  const n = Number.parseInt(value ?? "", 10);
  return Number.isInteger(n) && n >= min && n <= max ? n : fallback;
};

const library = pick(q.get("library"), ["all", ...LIBRARIES.map((l) => l.id)], "all");
const kind = pick(q.get("kind"), ["any", ...KINDS], "any");
const date = pick(q.get("date"), dates, now.date);
const hour = int(q.get("time"), 0, 23, date === now.date ? Math.min(now.hour + 1, 23) : 9);
const people = int(q.get("people"), 1, 8, 1);
const sort = pick(q.get("sort"), ["best", "seats", "name"], "best");
const selectedId = q.get("space");

type Free = Extract<State, { kind: "free" }>;
type Shared = Extract<State, { kind: "shared" }>;
type Result = { space: Space; state: Free | Shared };

const results: Result[] = [];
for (const space of SPACES) {
  if (library !== "all" && space.library !== library) continue;
  if (kind !== "any" && space.kind !== kind) continue;
  const state = sampleState(space, date, hour, now);
  if (state.kind === "free" && space.capacity >= people) results.push({ space, state });
  if (state.kind === "shared" && state.spare >= people) results.push({ space, state });
}
const seats = (r: Result) => (r.state.kind === "shared" ? r.state.spare : r.space.capacity);
if (sort === "best") {
  results.sort((a, b) => seats(a) - people - (seats(b) - people) || a.space.order - b.space.order);
} else if (sort === "seats") {
  results.sort((a, b) => seats(b) - seats(a) || a.space.order - b.space.order);
}
const SHOWN = 40;
const shown = results.slice(0, SHOWN);

const href = (extra: Record<string, string | null> = {}) => {
  const p = new URLSearchParams({
    library,
    kind,
    date,
    time: hourLabel(hour),
    people: String(people),
    sort,
  });
  for (const [k, v] of Object.entries(extra)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  return `/?${p}`;
};

const dayParts = (d: string) => {
  const dt = new Date(`${d}T12:00:00Z`);
  const f = (o: Intl.DateTimeFormatOptions) => dt.toLocaleDateString("en-AU", { ...o, timeZone: "UTC" });
  return { weekday: f({ weekday: "short" }), rest: f({ day: "numeric", month: "short" }) };
};
const selected = selectedId ? getSpace(selectedId) : undefined;
const slotHours = Array.from({ length: Math.min(8, 24 - hour) }, (_, i) => hour + i);
const usage = user ? usageToday(sampleBookings(now), now) : null;
const timePassed = date === now.date && hour < now.hour;
const libraryText = library === "all" ? "All libraries" : libraryName(library as never);
const kindText = kind === "any" ? "Any type" : KIND_LABEL[kind as keyof typeof KIND_LABEL];
const whenText = `${date === now.date ? "Today" : `${dayParts(date).weekday} ${dayParts(date).rest}`}, ${hourLabel(hour)}`;
const peopleText = `${people} ${people === 1 ? "person" : "people"}`;
---

<Base title="Find a study space" current="search">
  <main id="main">
    <h1>Find a study space</h1>

    <form class="panel filters" id="filters" method="get" action="/" aria-label="Search filters">
      <div class="pills">
        <div class="pill" data-pop="library">
          <details class="pop">
            <summary>{libraryText}</summary>
            <fieldset class="pop-body">
              <legend>Library</legend>
              <div class="chips">
                {
                  [{ id: "all", name: "All libraries" }, ...LIBRARIES].map((l) => (
                    <label class="chip">
                      <input type="radio" name="library" value={l.id} checked={library === l.id} />
                      <span>{l.name}</span>
                    </label>
                  ))
                }
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {library !== "all" && <a class="pill-x" href={href({ library: "all" })} aria-label={`Clear library: ${libraryText}`}><Icon name="x" size={14} /></a>}
        </div>

        <div class="pill" data-pop="kind">
          <details class="pop">
            <summary>{kindText}</summary>
            <fieldset class="pop-body">
              <legend>Space type</legend>
              <div class="chips">
                <label class="chip">
                  <input type="radio" name="kind" value="any" checked={kind === "any"} />
                  <span>Any type</span>
                </label>
                {
                  KINDS.map((k) => (
                    <label class="chip">
                      <input type="radio" name="kind" value={k} checked={kind === k} />
                      <span>{KIND_LABEL[k]}</span>
                    </label>
                  ))
                }
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {kind !== "any" && <a class="pill-x" href={href({ kind: "any" })} aria-label={`Clear type: ${kindText}`}><Icon name="x" size={14} /></a>}
        </div>

        <div class="pill" data-pop="when" data-keep>
          <details class="pop">
            <summary>{whenText}</summary>
            <fieldset class="pop-body pop-wide">
              <legend>Date</legend>
              <div class="chips days">
                {
                  dates.map((d, i) => (
                    <label class="chip chip-day">
                      <input type="radio" name="date" value={d} checked={date === d} />
                      <span>
                        <span class="chip-top">{i === 0 ? "Today" : dayParts(d).weekday}</span>
                        <span class="chip-sub">{dayParts(d).rest}</span>
                      </span>
                    </label>
                  ))
                }
              </div>
              <label class="field">
                Start time
                <select name="time">
                  {
                    Array.from({ length: 24 }, (_, h) => (
                      <option value={hourLabel(h)} selected={hour === h}>
                        {hourLabel(h)}
                      </option>
                    ))
                  }
                </select>
              </label>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
        </div>

        <div class="pill" data-pop="people" data-keep>
          <details class="pop">
            <summary>{peopleText}</summary>
            <fieldset class="pop-body">
              <legend>People</legend>
              <div class="stepper">
                <button type="button" class="stepper-btn" data-step="-1" aria-label="Fewer people" hidden>−</button>
                <input id="people" type="number" name="people" min="1" max="8" value={people} inputmode="numeric" aria-label="Number of people" />
                <button type="button" class="stepper-btn" data-step="1" aria-label="More people" hidden>+</button>
              </div>
              <button type="button" class="pop-done" hidden>Done</button>
            </fieldset>
          </details>
          {people > 1 && <a class="pill-x" href={href({ people: "1" })} aria-label={`Clear people: ${peopleText}`}><Icon name="x" size={14} /></a>}
        </div>

        <button type="submit" id="filters-go">Search</button>
      </div>
    </form>

    <div class="search-layout">
      <section aria-labelledby="results-heading">
        <div class="results-head">
          <h2 id="results-heading">{`${results.length} ${results.length === 1 ? "option" : "options"}`}</h2>
          <label class="sort">
            Sort
            <select name="sort" form="filters">
              <option value="best" selected={sort === "best"}>Best fit</option>
              <option value="seats" selected={sort === "seats"}>Most seats</option>
              <option value="name" selected={sort === "name"}>Name</option>
            </select>
          </label>
        </div>
        {
          results.length === 0 && (
            <p class="callout-info" role="status">
              {timePassed
                ? "That time has already passed. Pick a later hour."
                : "Nothing fits. Try another time, fewer people, or a different library."}
            </p>
          )
        }

        <ul class="results">
          {
            shown.map(({ space, state }) => (
              <li>
                <a
                  class="card result"
                  href={href({ space: space.id })}
                  aria-current={selected?.id === space.id ? "true" : undefined}
                >
                  <span class="result-top">
                    <strong>{space.name}</strong>
                    {state.kind === "free" ? (
                      <span class="badge badge-free">
                        <Icon name="check" size={16} /> Free · {space.capacity}{" "}
                        {space.capacity === 1 ? "seat" : "seats"}
                      </span>
                    ) : (
                      <span class="badge badge-shared">
                        <Icon name="users" size={16} /> {state.spare} of {space.capacity} seats open
                      </span>
                    )}
                  </span>
                  <span class="meta">
                    {libraryName(space.library)} · {KIND_LABEL[space.kind]} · {slotLabel(hour)}
                    {state.kind === "shared" && <> · Booked by {state.booker ?? "A student"}</>}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          results.length > SHOWN && (
            <p class="muted">
              Showing the first {SHOWN} of {results.length}. Narrow the filters to see the rest.
            </p>
          )
        }
      </section>

      {
        selected ? (
          <section class="sheet is-open" id="details" aria-labelledby="details-heading">
            <div class="sheet-head">
              <div>
                <h2 id="details-heading">{selected.name}</h2>
                <p class="muted">
                  {libraryName(selected.library)} · {KIND_LABEL[selected.kind]} · capacity{" "}
                  {selected.capacity}
                </p>
              </div>
              <a class="button button-quiet" href={href({ space: null })}>
                Close
              </a>
            </div>

            <p class="muted">{dateLabel(date)}. Each booking is one hour.</p>
            <ul class="slots">
              {slotHours.map((h) => {
                const state = sampleState(selected, date, h, now);
                return (
                  <li aria-current={h === hour ? "true" : undefined}>
                    <span class="slot-time">{slotLabel(h)}</span>
                    {state.kind === "free" && (
                      <>
                        <span class="badge badge-free">
                          <Icon name="check" size={16} /> Free
                        </span>
                        {user ? (
                          <button type="button" disabled>
                            Book
                          </button>
                        ) : (
                          <a class="button" href="/login/">
                            Sign in to book
                          </a>
                        )}
                      </>
                    )}
                    {state.kind === "shared" && (
                      <>
                        <span class="badge badge-shared">
                          <Icon name="users" size={16} /> {state.spare} seat
                          {state.spare === 1 ? "" : "s"} open
                        </span>
                        {user ? (
                          <button type="button" disabled>
                            Join
                          </button>
                        ) : (
                          <a class="button" href="/login/">
                            Sign in to join
                          </a>
                        )}
                      </>
                    )}
                    {state.kind === "booked" && (
                      <span class="badge badge-booked">
                        <Icon name="lock" size={16} /> Booked
                      </span>
                    )}
                    {state.kind === "past" && <span class="muted">Passed</span>}
                  </li>
                );
              })}
            </ul>

            {(() => {
              const state = sampleState(selected, date, hour, now);
              return (
                state.kind === "shared" && (
                  <div class="stack">
                    <p class="callout" role="note">
                      <strong>Seats on a shared booking aren’t guaranteed.</strong> The booker may
                      not turn up, or may use more space than they said.
                    </p>
                    <p class="muted">
                      Booked by <strong>{state.booker ?? "A student"}</strong>
                      {state.booker ? "" : " (name hidden by the booker)"}.
                    </p>
                    {state.requests ? (
                      <button type="button" disabled>
                        Ask the booker
                      </button>
                    ) : (
                      <p class="muted">The booker isn’t accepting requests for this booking.</p>
                    )}
                  </div>
                )
              );
            })()}

            {
              user && usage && (
                <p class="muted">
                  Today you’ve used {usage[poolOf(selected.kind)]} of{" "}
                  {POOLS[poolOf(selected.kind)].limit} {POOLS[poolOf(selected.kind)].label.toLowerCase()} bookings.
                </p>
              )
            }
            <p class="callout-info">
              <Icon name="info" size={16} /> Prototype: this shows sample data, and booking isn’t
              connected to the database yet.
            </p>
          </section>
        ) : (
          <p class="sheet-empty muted">Select an option to see its details and other times.</p>
        )
      }
    </div>
  </main>
</Base>

<script>
  // Enhancement only. Without JavaScript the pills open natively and the
  // Search button submits the form; the − / + and Done buttons stay hidden.
  const form = document.querySelector<HTMLFormElement>("#filters");
  if (form) {
    const store = {
      get: (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } },
      set: (k: string, v: string) => { try { sessionStorage.setItem(k, v); } catch { /* ignore */ } },
      del: (k: string) => { try { sessionStorage.removeItem(k); } catch { /* ignore */ } },
    };
    const pills = [...form.querySelectorAll<HTMLElement>(".pill")];
    const details = pills.map((p) => p.querySelector<HTMLDetailsElement>("details")!);
    const sheet = matchMedia("(max-width: 47.99rem)");

    form.querySelector<HTMLElement>("#filters-go")!.hidden = true;
    form.querySelectorAll<HTMLElement>(".stepper-btn, .pop-done").forEach((b) => (b.hidden = false));

    const sync = () => {
      const open = details.find((d) => d.open);
      document.documentElement.toggleAttribute("data-sheet", !!open);
      if (open) store.set("openPop", open.parentElement!.dataset.pop!);
      else store.del("openPop");
    };
    // Only one open at a time; Escape, Done and clicking outside close it.
    details.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) details.forEach((o) => o !== d && (o.open = false));
        sync();
      });
      d.querySelector(".pop-done")?.addEventListener("click", () => {
        d.open = false;
        d.querySelector("summary")?.focus();
      });
    });
    const closeAll = () => details.forEach((d) => (d.open = false));
    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest(".pill")) closeAll();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const d = details.find((x) => x.open);
      if (d) { d.open = false; d.querySelector("summary")?.focus(); }
    });

    // Date then time (and people) take a few taps, so those stay open after applying.
    const keep = store.get("openPop");
    const back = pills.find((p) => p.dataset.pop === keep && "keep" in p.dataset);
    if (back) back.querySelector("details")!.open = true;
    else store.del("openPop");
    void sheet;

    const input = form.querySelector<HTMLInputElement>("#people")!;
    form.querySelectorAll<HTMLElement>(".stepper-btn").forEach((b) =>
      b.addEventListener("click", () => {
        const next = Number(input.value) + Number(b.dataset.step);
        input.value = String(Math.min(8, Math.max(1, next)));
        form.dispatchEvent(new Event("change", { bubbles: true }));
      }),
    );

    // Apply on every change, keeping the scroll position across the reload.
    const submit = () => {
      store.set("searchScroll", String(scrollY));
      form.requestSubmit();
    };
    form.addEventListener("change", submit);
    document.querySelector<HTMLSelectElement>("select[name=sort]")?.addEventListener("change", submit);

    const y = store.get("searchScroll");
    if (y) {
      store.del("searchScroll");
      scrollTo(0, Number(y));
    }
  }
</script>
