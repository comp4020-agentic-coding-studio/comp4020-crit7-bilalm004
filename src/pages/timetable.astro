---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { KIND_LABEL, KINDS, LIBRARIES, SPACES, libraryName } from "../lib/rooms";
import { ADVANCE_DAYS } from "../lib/rules";
import { sampleState } from "../lib/sample";
import { bookableDates, canberraNow, dateLabel, hourLabel } from "../lib/time";

const q = Astro.url.searchParams;
const now = canberraNow();
const dates = bookableDates(now.date, ADVANCE_DAYS);

const pick = (value: string | null, allowed: readonly string[], fallback: string) =>
  allowed.includes(value ?? "") ? (value as string) : fallback;

const library = pick(q.get("library"), LIBRARIES.map((l) => l.id), "chifley");
const kind = pick(q.get("kind"), ["any", ...KINDS], "study_room");
const date = pick(q.get("date"), dates, now.date);

// A 12-hour window over one continuous run of hours (today 00:00 to the end of
// the last bookable day), so Later carries on past midnight into the next day.
// `start` is hours since today 00:00 (Canberra); links and the slider set it.
const WINDOW = 12;
const STEP = 6;
const total = dates.length * 24;
const maxStart = total - WINDOW;
const startParam = Number.parseInt(q.get("start") ?? "", 10);
const dateStart = dates.indexOf(date) * 24 + (date === now.date ? now.hour : 8);
const start = Math.max(0, Math.min(Number.isInteger(startParam) ? startParam : dateStart, maxStart));
const cols = Array.from({ length: WINDOW }, (_, i) => {
  const abs = start + i;
  return { date: dates[Math.floor(abs / 24)], hour: abs % 24 };
});
const first = cols[0];
const last = cols[WINDOW - 1];
const rangeLabel =
  first.date === last.date
    ? dateLabel(first.date)
    : `${dateLabel(first.date)} – ${dateLabel(last.date)}`;
const sliderText = `${dateLabel(first.date)}, ${hourLabel(first.hour)}`;

const spaces = SPACES.filter(
  (s) => s.library === library && (kind === "any" || s.kind === kind),
);

const link = (s: number) =>
  `/timetable/?${new URLSearchParams({ library, kind, start: String(s) })}`;
const details = (spaceId: string, d: string, h: number) =>
  `/?${new URLSearchParams({ library, kind: "any", date: d, time: hourLabel(h), people: "1", sort: "best", space: spaceId })}`;
---

<Base title="Timetable" current="timetable">
  <main id="main">
    <h1>Timetable</h1>
    <p class="lede">
      The whole day for one library. Choose a free or shared cell to see its details.
    </p>

    <form class="panel timetable-filters" method="get" action="/timetable/" aria-label="Timetable filters">
      <label>
        Library
        <select name="library">
          {
            LIBRARIES.map((l) => (
              <option value={l.id} selected={library === l.id}>
                {l.name}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        Space type
        <select name="kind">
          <option value="any" selected={kind === "any"}>Any type</option>
          {
            KINDS.map((k) => (
              <option value={k} selected={kind === k}>
                {KIND_LABEL[k]}
              </option>
            ))
          }
        </select>
      </label>
      <label>
        Date
        <select name="date">
          {
            dates.map((d, i) => (
              <option value={d} selected={first.date === d}>
                {dateLabel(d)}
                {i === 0 ? " (today)" : ""}
              </option>
            ))
          }
        </select>
      </label>
      <button type="submit">Show</button>
    </form>

    <div class="timetable-head">
      <h2>{libraryName(library as never)} · {rangeLabel}</h2>
      <p class="row">
        {
          start > 0 ? (
            <a class="button button-quiet" href={link(Math.max(0, start - STEP))}>
              ← Earlier
            </a>
          ) : (
            <span class="button button-quiet is-off" aria-hidden="true">
              ← Earlier
            </span>
          )
        }
        {
          start < maxStart ? (
            <a class="button button-quiet" href={link(Math.min(maxStart, start + STEP))}>
              Later →
            </a>
          ) : (
            <span class="button button-quiet is-off" aria-hidden="true">
              Later →
            </span>
          )
        }
      </p>
    </div>

    <form class="slider panel" data-today={`${now.date}T12:00:00Z`} method="get" action="/timetable/" aria-label="Move through time">
      <input type="hidden" name="library" value={library} />
      <input type="hidden" name="kind" value={kind} />
      <label for="start">Jump to</label>
      <input id="start" name="start" type="range" min="0" max={maxStart} step="1" value={start} />
      <output for="start" id="start-out">{sliderText}</output>
      <button type="submit" class="button button-quiet" id="start-go">Go</button>
    </form>

    {
      spaces.length === 0 ? (
        <p class="callout-info" role="status">
          This library has no spaces of that type. Try another type.
        </p>
      ) : (
        <div class="scroll" role="region" aria-label="Timetable, scrolls sideways" tabindex="0">
          <table class="grid">
            <thead>
              <tr>
                <th scope="col">
                  <span class="sr-only">Space</span>
                </th>
                {cols.map((c, i) => (
                  <th scope="col">
                    {(i === 0 || c.hour === 0) && <span class="day">{dateLabel(c.date)}</span>}
                    {hourLabel(c.hour)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {spaces.map((space) => (
                <tr>
                  <th scope="row">
                    {space.name}
                    <span class="cap">
                      {space.capacity} {space.capacity === 1 ? "seat" : "seats"}
                    </span>
                  </th>
                  {cols.map(({ date: d, hour: h }) => {
                    const state = sampleState(space, d, h, now);
                    const label = `${space.name}, ${hourLabel(h)}`;
                    if (state.kind === "past")
                      return (
                        <td class="cell cell-past">
                          <span>
                            <span class="sr-only">{label}, passed</span>
                          </span>
                        </td>
                      );
                    if (state.kind === "booked")
                      return (
                        <td class="cell cell-booked">
                          <span>
                            <Icon name="lock" size={16} />
                            <span class="sr-only">{label}, booked</span>
                          </span>
                        </td>
                      );
                    if (state.kind === "shared")
                      return (
                        <td class="cell cell-shared">
                          <a
                            href={details(space.id, d, h)}
                            aria-label={`${label}, ${state.spare} seats open`}
                          >
                            <Icon name="users" size={16} /> {state.spare}
                          </a>
                        </td>
                      );
                    return (
                      <td class="cell cell-free">
                        <a href={details(space.id, d, h)} aria-label={`${label}, free`}>
                          <Icon name="check" size={16} />
                        </a>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    <p class="legend" aria-label="Legend">
      <span class="badge badge-free"><Icon name="check" size={16} /> Free</span>
      <span class="badge badge-shared"><Icon name="users" size={16} /> Seats open (number)</span>
      <span class="badge badge-booked"><Icon name="lock" size={16} /> Booked</span>
    </p>
    <p class="callout-info">
      <Icon name="info" size={16} /> Prototype: this shows sample data. The number after the icon is how
      many seats are open on a shared booking.
    </p>
  </main>
</Base>

<script>
  // Enhancement only: without JavaScript the Go button submits the slider.
  const form = document.querySelector<HTMLFormElement>(".slider");
  const input = form?.querySelector<HTMLInputElement>("#start");
  const out = form?.querySelector<HTMLOutputElement>("#start-out");
  const go = form?.querySelector<HTMLElement>("#start-go");
  if (form && input && out && go) {
    go.hidden = true;
    const today = new Date(form.dataset.today ?? "");
    const label = (n: number) => {
      const d = new Date(today);
      d.setUTCDate(d.getUTCDate() + Math.floor(n / 24));
      const day = d.toLocaleDateString("en-AU", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
      return `${day}, ${String(n % 24).padStart(2, "0")}:00`;
    };
    input.addEventListener("input", () => (out.textContent = label(Number(input.value))));
    input.addEventListener("change", () => form.requestSubmit());
  }
</script>
