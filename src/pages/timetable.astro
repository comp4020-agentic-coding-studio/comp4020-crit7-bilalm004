---
// The timetable now lives on the Search page as its Timetable view. This keeps
// old links working, including the old `start` parameter.
const p = new URLSearchParams(Astro.url.search);
p.set("view", "grid");
const start = p.get("start");
if (start !== null) {
  p.set("from", start);
  p.delete("start");
}
return Astro.redirect(`/?${p}`, 301);
---
