---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { spareSeats } from "../lib/booking";
import { usageToday } from "../lib/availability";
import { bookingsOf, checkedInJoins, joinedBy, joinersOf } from "../lib/db";
import { KIND_LABEL, getSpace, libraryName } from "../lib/rooms";
import { POOLS, type PoolId } from "../lib/rules";
import { canberraNow, dateLabel, slotLabel } from "../lib/time";
import { DEMO_USERS, getUser } from "../lib/users";

const user = getUser(Astro.cookies);
const now = canberraNow();
const rows = user ? bookingsOf(user.id) : [];
const joinedRows = user ? joinedBy(user.id) : [];
const usage = usageToday(rows, now);
const pools = Object.keys(POOLS) as PoolId[];
const joiners = joinersOf(rows.map((b) => b.id));
const arrived = joinersOf(rows.map((b) => b.id), true);
const myCheckIns = user ? checkedInJoins(user.id) : new Set<number>();
const when = (iso: string) => {
  const at = canberraNow(new Date(iso));
  return `${dateLabel(at.date)}, ${slotLabel(at.hour)}`;
};

const bookings = rows.flatMap((b) => {
  const space = getSpace(b.roomId);
  return space ? [{ b, space, joined: joiners.get(b.id)?.length ?? 0, here: arrived.get(b.id)?.length ?? 0 }] : [];
});
const joinedList = joinedRows.flatMap((b) => {
  const space = getSpace(b.roomId);
  // Privacy: a private booker stays "A student".
  const booker = b.namePublic ? (DEMO_USERS.find((u) => u.id === b.userId)?.name ?? null) : null;
  return space ? [{ b, space, booker }] : [];
});
const q = Astro.url.searchParams;
---

<Base title="My bookings" current="bookings">
  <main id="main" class="narrow">
    <h1>My bookings</h1>
    {q.get("error") && <p class="error" role="alert"><Icon name="x" size={16} /> {q.get("error")}</p>}
    {q.has("cancelled") && <p class="callout-info" role="status"><Icon name="check" size={16} /> Booking cancelled.</p>}
    {q.has("saved") && <p class="callout-info" role="status"><Icon name="check" size={16} /> Sharing updated.</p>}
    {q.has("checkedin") && <p class="callout-info" role="status"><Icon name="check" size={16} /> Checked in.</p>}
    {q.has("left") && <p class="callout-info" role="status"><Icon name="check" size={16} /> You’ve left that booking.</p>}
    {
      !user ? (
        <div class="stack">
          <p class="callout-info" role="status">Sign in to see your bookings.</p>
          <a class="button" href="/login/?next=/bookings/">Sign in</a>
        </div>
      ) : (
        <>
          <section aria-labelledby="usage-heading">
            <h2 id="usage-heading">Today’s limits</h2>
            <p class="muted">
              Each booking is one hour. Joining someone else’s booking doesn’t use up your limit.
            </p>
            <ul class="usage">
              {pools.map((id) => (
                <li>
                  <div class="usage-row">
                    <span>{POOLS[id].label}</span>
                    <strong>
                      {usage[id]} of {POOLS[id].limit} used
                    </strong>
                  </div>
                  <div class="meter" aria-hidden="true">
                    <span style={`width:${Math.min(100, (usage[id] / POOLS[id].limit) * 100)}%`} />
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="upcoming-heading">
            <h2 id="upcoming-heading">Upcoming</h2>
            {bookings.length === 0 && <p class="muted">No upcoming bookings. Find a space to book one.</p>}
            <ul class="messages">
              {bookings.map(({ b, space, joined, here }) => (
                <li class="card">
                  <p class="message-title">
                    <strong>{space.name}</strong>
                    {b.shared ? (
                      <span class="badge badge-shared">
                        <Icon name="users" size={16} /> Shared
                      </span>
                    ) : (
                      <span class="badge badge-booked">
                        <Icon name="lock" size={16} /> Not shared
                      </span>
                    )}
                  </p>
                  <p class="muted">
                    {libraryName(space.library)} · {KIND_LABEL[space.kind]} · {when(b.startUtc)}
                  </p>
                  {b.shared && (
                    <p class="muted">
                      You’re using {b.seatsUsed} of {space.capacity} seats · {joined}{" "}
                      {joined === 1 ? "person has" : "people have"} joined ·{" "}
                      {spareSeats(space.capacity, b.seatsUsed, joined)} spare · your name is{" "}
                      {b.namePublic ? "public" : "hidden"}
                    </p>
                    <p class="occupancy">
                      <Icon name="users" size={16} /> {joined} joined · {here} checked in
                    </p>
                  )}
                  {space.shareable ? (
                    <form method="post" action="/api/share/" class="stack">
                      <input type="hidden" name="booking" value={b.id} />
                      <input type="hidden" name="next" value="/bookings/" />
                      <details class="share-opts">
                        <summary>{b.shared ? "Change sharing" : "Share spare seats"}</summary>
                        <label class="check">
                          <input type="checkbox" name="shared" value="1" checked={b.shared} /> Let others join
                          this booking
                        </label>
                        <label class="field-inline">
                          Seats I’ll use
                          <select name="seats">
                            {Array.from({ length: space.capacity - 1 }, (_, i) => i + 1).map((n) => (
                              <option value={n} selected={n === b.seatsUsed}>{n}</option>
                            ))}
                          </select>
                        </label>
                        <label class="check">
                          <input type="checkbox" name="name_public" value="1" checked={b.namePublic} /> Show my
                          name (otherwise others see “A student”)
                        </label>
                        <label class="field-inline">
                          Let people ask me for a seat
                          <select name="requests">
                            <option value="on" selected={b.requestsOn}>On</option>
                            <option value="off" selected={!b.requestsOn}>Off</option>
                          </select>
                        </label>
                        <p class="callout" role="note">
                          <strong>Seats on a shared booking aren’t guaranteed.</strong> Others are told this
                          before they join.
                        </p>
                        <button type="submit">Save sharing</button>
                      </details>
                    </form>
                  ) : (
                    <p class="muted">A single-seat space can’t be shared.</p>
                  )}
                  <div class="row">
                    <form method="post" action="/api/cancel/">
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="next" value="/bookings/" />
                      <button type="submit" class="button-quiet">Cancel booking</button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="joined-heading">
            <h2 id="joined-heading">Joined</h2>
            {joinedList.length === 0 && <p class="muted">You haven’t joined anyone’s booking.</p>}
            <ul class="messages">
              {joinedList.map(({ b, space, booker }) => (
                <li class="card">
                  <p class="message-title">
                    <strong>{space.name}</strong>
                    <span class="badge badge-shared">
                      <Icon name="users" size={16} /> Joined
                    </span>
                  </p>
                  <p class="muted">
                    {libraryName(space.library)} · {KIND_LABEL[space.kind]} · {when(b.startUtc)} · booked by{" "}
                    {booker ?? "A student"}
                  </p>
                  <p class="callout" role="note">
                    <strong>Your seat isn’t guaranteed.</strong> The booker may not turn up, or may use more
                    space than they said.
                  </p>
                  <div class="row">
                    {myCheckIns.has(b.id) ? (
                      <span class="badge badge-free"><Icon name="check" size={16} /> Checked in</span>
                    ) : (
                      <form method="post" action="/api/checkin/">
                        <input type="hidden" name="booking" value={b.id} />
                        <input type="hidden" name="next" value="/bookings/" />
                        <button type="submit">Check in</button>
                      </form>
                    )}
                    <form method="post" action="/api/leave/">
                      <input type="hidden" name="booking" value={b.id} />
                      <input type="hidden" name="next" value="/bookings/" />
                      <button type="submit" class="button-quiet">Leave</button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
</Base>
