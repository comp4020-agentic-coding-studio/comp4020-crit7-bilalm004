---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { KIND_LABEL, libraryName } from "../lib/rooms";
import { POOLS, type PoolId } from "../lib/rules";
import { usageToday } from "../lib/availability";
import { bookingsOf } from "../lib/db";
import { getSpace } from "../lib/rooms";
import { canberraNow, dateLabel, slotLabel } from "../lib/time";
import { getUser } from "../lib/users";

const user = getUser(Astro.cookies);
const now = canberraNow();
const rows = user ? bookingsOf(user.id) : [];
const usage = usageToday(rows, now);
const bookings = rows.flatMap((b) => {
  const space = getSpace(b.roomId);
  const at = canberraNow(new Date(b.startUtc));
  return space ? [{ id: b.id, space, date: at.date, hour: at.hour }] : [];
});
const q = Astro.url.searchParams;
const pools = Object.keys(POOLS) as PoolId[];
---

<Base title="My bookings" current="bookings">
  <main id="main" class="narrow">
    <h1>My bookings</h1>
    {q.get("error") && <p class="error" role="alert"><Icon name="x" size={16} /> {q.get("error")}</p>}
    {q.has("cancelled") && <p class="callout-info" role="status"><Icon name="check" size={16} /> Booking cancelled.</p>}
    {
      !user ? (
        <div class="stack">
          <p class="callout-info" role="status">Sign in to see your bookings.</p>
          <a class="button" href="/login/?next=/bookings/">Sign in</a>
        </div>
      ) : (
        <>
          <section aria-labelledby="usage-heading">
            <h2 id="usage-heading">Today’s limits</h2>
            <p class="muted">
              Each booking is one hour. Joining someone else’s booking doesn’t use up your limit.
            </p>
            <ul class="usage">
              {pools.map((id) => (
                <li>
                  <div class="usage-row">
                    <span>{POOLS[id].label}</span>
                    <strong>
                      {usage[id]} of {POOLS[id].limit} used
                    </strong>
                  </div>
                  <div class="meter" aria-hidden="true">
                    <span style={`width:${Math.min(100, (usage[id] / POOLS[id].limit) * 100)}%`} />
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section aria-labelledby="upcoming-heading">
            <h2 id="upcoming-heading">Upcoming</h2>
            {bookings.length === 0 && <p class="muted">No upcoming bookings. Find a space to book one.</p>}
            <ul class="messages">
              {bookings.map((b) => (
                <li class="card">
                  <p class="message-title">
                    <strong>{b.space.name}</strong>
                  </p>
                  <p class="muted">
                    {libraryName(b.space.library)} · {KIND_LABEL[b.space.kind]} · {dateLabel(b.date)},{" "}
                    {slotLabel(b.hour)}
                  </p>
                  <div class="row">
                    <form method="post" action="/api/cancel/">
                      <input type="hidden" name="id" value={b.id} />
                      <input type="hidden" name="next" value="/bookings/" />
                      <button type="submit" class="button-quiet">Cancel booking</button>
                    </form>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
</Base>
